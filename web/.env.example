# Browser-side Supabase access for the dashboard.
#
# The anon key is SELECT-only behind row-level security (DataModel.md's
# Security convention), which is what makes a backend-free dashboard safe.
# NEVER put SUPABASE_SERVICE_ROLE_KEY here - Vite inlines every VITE_* value
# into the public bundle, and service_role bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
