# Red-team harness / drift sampler / reference agent LLMs.
# No Anthropic/Claude key — dropped deliberately, see README's
# design-decisions section.
GROQ_API_KEY=
GEMINI_API_KEY=

# Razorpay test-mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase — anon key is public-safe ONLY with RLS enabled and a SELECT-only
# policy on it (see DataModel.md > Cross-cutting conventions > Security).
# Never use SUPABASE_SERVICE_ROLE_KEY outside harness/sentinel backend scripts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
