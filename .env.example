# Red-team harness / drift sampler / reference agent LLMs.
# No Anthropic/Claude key — dropped deliberately, see README's
# design-decisions section.
GROQ_API_KEY=
GEMINI_API_KEY=

# Pacing for outbound Gemini calls (agent/reference_agent.py::_throttle).
# The free tier caps at ~15 requests/minute AND 500 requests/day - retry
# alone can't fix either, since it only reacts once the cap is already hit.
# 4.5s spacing keeps a run under the per-minute cap by construction.
# On a billed key neither cap binds: set 0.5 (or 0) so full runs don't take
# an hour of deliberate waiting. See BUGS.md's Gemini quota entries.
GEMINI_MIN_INTERVAL_SECONDS=4.5

# Simulator model for attack generation, separate from the judge - the judge
# model refuses to WRITE commerce attacks (see BUGS.md). Note this one is
# NOT covered by Groq's paid tier: it reports 1000 requests/day, which is
# the next bottleneck after Gemini's, at roughly 4 full runs per day.
GROQ_SIMULATOR_MODEL=qwen/qwen3.8-27b

# Razorpay test-mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase — anon key is public-safe ONLY with RLS enabled and a SELECT-only
# policy on it (see DataModel.md > Cross-cutting conventions > Security).
# Never use SUPABASE_SERVICE_ROLE_KEY outside harness/sentinel backend scripts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
