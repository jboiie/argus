# Red-team harness / drift sampler / reference agent (v1) LLMs
GROQ_API_KEY=
GEMINI_API_KEY=

# Reference agent LLM — v1 uses Gemini above. Optional post-project upgrade
# once free-tier build/testing is done and billing is deliberately set up.
ANTHROPIC_API_KEY=

# Razorpay test-mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase — anon key is public-safe ONLY with RLS enabled and a SELECT-only
# policy on it (see DataModel.md > Cross-cutting conventions > Security).
# Never use SUPABASE_SERVICE_ROLE_KEY outside harness/sentinel backend scripts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
