# Streamlit Cloud reads secrets from its own "Secrets" UI (Settings ->
# Secrets), not from .env - paste this file's content there (with real
# values) when deploying dashboard/app.py.
#
# Read-only dashboard: anon key ONLY, never service_role - see
# DataModel.md's Security convention. The dashboard has no write path,
# so service_role would be a needless privilege escalation if it ever
# leaked from the deployed app.

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key"
